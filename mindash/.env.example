# Supabase 연결 정보 — 실제 값은 .env.local 에 넣으세요 (이 파일은 예시)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# 사이트 기준 URL (이메일 확인/리다이렉트용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini 챗봇 (Google AI Studio에서 발급: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# 유효 모델 예: gemini-flash-latest / gemini-3.5-flash / gemini-2.5-flash / gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-latest
